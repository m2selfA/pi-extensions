{
  "name": "@narumitw/pi-wispterm-status",
  "version": "0.1.0",
  "description": "Emit WispTerm OSC 7748 agent-status markers from Pi lifecycle events.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "wispterm",
    "osc-7748",
    "agent-status",
    "terminal"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-wispterm-status"
  }
}
